# Supabase project — used by src/utils/supabase-info.ts at runtime.
# Get these values from https://supabase.com/dashboard/project/<your-project-id>/settings/api
#
# - NEXT_PUBLIC_SUPABASE_PROJECT_ID is the project ref (e.g. "tkdxkpzpkhhhlyfdtjde").
# - NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is the new "publishable" key (sb_publishable_...),
#   which replaces the legacy "anon" JWT key. It's safe to expose in client code.
#   Do NOT use the secret key (sb_secret_...) here — that's server-only.
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is gitignored.
# In Vercel, set the same two keys under Project Settings → Environment Variables
# for both Preview and Production.

NEXT_PUBLIC_SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
